# Dependencies (المكتبات الثقيلة - لا ترفعها أبداً)
/node_modules
/.pnpm-store

# Next.js Build Output (مجلدات البناء - لا ترفعها)
/.next/
/out/
/build

# Environment Variables (ملفات السرية والربط - لا ترفعها لأسباب أمنية)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
